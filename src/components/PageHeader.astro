---
// Encabezado de páginas interiores: franja verde de marca con título, texto e ilustración
import { Image } from 'astro:assets';
import Arcs from './Arcs.astro';

interface Props {
  eyebrow?: string;
  lead?: string;
  illustration?: ImageMetadata;
  illustrationAlt?: string;
}
const { eyebrow, lead, illustration, illustrationAlt = '' } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-leaf">
  <Arcs class="absolute -right-32 -bottom-24 -z-10 h-[520px] w-auto opacity-90 md:-right-20" />
  <div class="mx-auto grid max-w-[1320px] items-center gap-10 px-5 pt-14 pb-16 md:px-10 lg:grid-cols-12 lg:pt-20 lg:pb-24">
    <div class="lg:col-span-7">
      {eyebrow && <p class="page-in font-bold text-forest-deep">{eyebrow}</p>}
      <h1 class="page-in mt-3 text-display" style="--d:60ms"><slot /></h1>
      {lead && <p class="page-in mt-6 max-w-2xl text-lead text-ink/80" style="--d:140ms">{lead}</p>}
      <slot name="actions" />
    </div>
    {
      illustration && (
        <div class="page-in lg:col-span-4 lg:col-start-9" style="--d:200ms">
          <Image
            src={illustration}
            alt={illustrationAlt}
            widths={[400, 640]}
            sizes="(min-width: 1024px) 30vw, 80vw"
            loading="eager"
            class="mx-auto w-full max-w-sm lg:max-w-none"
          />
        </div>
      )
    }
  </div>
</section>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    .page-in {
      animation: page-rise 0.8s var(--ease-snap) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes page-rise {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }
</style>

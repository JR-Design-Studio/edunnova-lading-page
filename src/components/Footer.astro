---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-horizontal-light.webp';
import Arcs from './Arcs.astro';
import SocialIcon from './SocialIcon.astro';
import { nav, site, tel } from '../data/site';

const year = new Date().getFullYear();
const socials = [
  { href: site.social.facebook, label: 'Facebook', icon: 'facebook' },
  { href: site.social.instagram, label: 'Instagram', icon: 'instagram' },
  { href: site.social.youtube, label: 'YouTube', icon: 'youtube' },
] as const;
---

<footer class="relative overflow-hidden bg-forest-deep text-white">
  <Arcs
    class="pointer-events-none absolute -right-20 -bottom-20 h-[420px] w-auto opacity-50"
    color="#04624e"
    animate={false}
  />
  <div class="relative mx-auto max-w-[1320px] px-5 pt-20 pb-10 md:px-10">
    <div class="grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <Image src={logo} alt="Edunnova, agencia educativa" height={120} class="h-12 w-auto" />
        <p class="mt-6 max-w-sm text-lead text-white/75">{site.tagline}</p>
        <ul class="mt-8 flex gap-3">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`Edunnova en ${s.label}`}
                  title={s.label}
                  class="grid size-11 place-items-center rounded-full bg-white/10 transition-colors hover:bg-leaf hover:text-ink"
                >
                  <SocialIcon name={s.icon} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid gap-10 sm:grid-cols-2 lg:col-span-7">
        <div>
          <p class="font-bold text-leaf">Navegación</p>
          <ul class="mt-4 space-y-2 text-white/80">
            {
              nav.map((n) => (
                <li>
                  <a href={n.href} class="hover:text-white">
                    {n.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <p class="font-bold text-leaf">Contáctanos</p>
          <address class="mt-4 space-y-3 not-italic text-white/80">
            <a href={`mailto:${site.email}`} class="block hover:text-white">{site.email}</a>
            <a href={tel} class="block hover:text-white">{site.phone}</a>
            <a href={site.mapLink} target="_blank" rel="noopener" class="block leading-snug hover:text-white">
              {site.address.street}, {site.address.area}, {site.address.postalCode}, {site.address.city},
              {site.address.region}
            </a>
          </address>
        </div>
      </div>
    </div>
    <div class="mt-20 flex flex-col justify-between gap-2 border-t border-white/10 pt-6 text-sm text-white/55 sm:flex-row">
      <p>© {year} Edunnova. Todos los derechos reservados.</p>
      <p>Registro STPS {site.stpsRegistry}</p>
    </div>
  </div>
</footer>

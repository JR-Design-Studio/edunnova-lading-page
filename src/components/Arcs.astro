---
// Arcos concéntricos del logotipo ("((e"): se dibujan solos al cargar
interface Props {
  class?: string;
  color?: string;
  animate?: boolean;
}
const { class: cls, color = 'var(--color-forest)', animate = true } = Astro.props;
// Semicírculos con centro en la esquina inferior derecha: la mitad derecha queda fuera
// del SVG (overflow visible) para que los arcos nunca muestren un corte recto.
const rings = [500, 340, 180];
const W = 76;
const arc = (r: number) => `M ${600 - r} 600 A ${r} ${r} 0 0 1 ${600 + r} 600`;
---

<svg viewBox="0 0 600 600" overflow="visible" class:list={['arcs overflow-visible', animate && 'arcs-animate', cls]} aria-hidden="true" fill="none">
  {
    rings.map((r, i) => (
      <path d={arc(r)} stroke={color} stroke-width={W} pathLength="1" style={`--i:${i}`} />
    ))
  }
</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .arcs-animate path[pathLength] {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.3s var(--ease-snap) forwards;
      animation-delay: calc(var(--i) * 140ms + 150ms);
    }
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
</style>

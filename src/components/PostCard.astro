---
import { formatDate, type Post } from '../data/posts';

interface Props {
  post: Post;
  eager?: boolean;
}
const { post, eager = false } = Astro.props;
---

<a href={`/${post.slug}/`} class="group flex flex-col overflow-hidden rounded-[24px] bg-white">
  <div class="aspect-[4/3] overflow-hidden bg-mist">
    {
      post.cover ? (
        <img
          src={post.cover.src}
          width={post.cover.width}
          height={post.cover.height}
          alt=""
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="size-full object-cover transition-transform duration-700 ease-snap group-hover:scale-[1.04]"
        />
      ) : (
        <div class="grid size-full place-items-center bg-forest p-8 text-center text-2xl font-extrabold text-leaf">Artículo</div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <time datetime={post.date} class="text-sm font-bold text-forest">{formatDate(post.date)}</time>
    <h3 class="mt-2 text-xl leading-snug font-extrabold text-pretty group-hover:text-grape">{post.title}</h3>
    <p class="mt-3 line-clamp-3 text-[15px] text-muted">{post.excerpt}</p>
  </div>
</a>

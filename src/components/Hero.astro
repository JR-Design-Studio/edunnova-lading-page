---
/**
 * Portada de inicio. Reconstruye el banner original (una sola imagen con todo "quemado")
 * como componente: el texto es HTML real, la estudiante es un recorte transparente
 * y los arcos del logotipo son SVG animado.
 */
import { Image } from 'astro:assets';
import Mark from './Mark.astro';
import Arcs from './Arcs.astro';
import student from '../assets/hero/estudiante.png';
import { site } from '../data/site';

const proof = [
  'Evaluador independiente de la Red CONOCER',
  `Capacitador externo registrado ante la STPS`,
  'Validez oficial SEP, CONOCER y UACH',
];
---

<section class="relative isolate overflow-hidden bg-leaf">
  <div class="mx-auto grid max-w-[1320px] lg:min-h-[min(86svh,760px)] lg:grid-cols-12">
    <!-- Texto -->
    <div class="relative z-10 flex flex-col justify-center px-5 pt-14 pb-6 md:px-10 lg:col-span-7 lg:py-20">
      <h1 class="hero-in text-display text-ink">
        El futuro<br />se construye<br /><Mark class="mt-[0.2em] inline-block leading-[1.12]">aprendiendo</Mark>
      </h1>
      <p class="hero-in mt-7 max-w-xl text-lead text-ink/80" style="--d:120ms">
        Convertimos el aprendizaje en resultados medibles: certificaciones con validez oficial, capacitación con registro
        STPS y consultoría para empresas y organizaciones.
      </p>
      <div class="hero-in mt-9 flex flex-wrap gap-3" style="--d:220ms">
        <a
          href="/servicios/"
          class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-bold text-white transition-transform hover:-translate-y-0.5"
        >
          Conoce los servicios
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"
            ><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
            ></path></svg
          >
        </a>
        <a
          href={site.whatsapp}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full bg-white/90 px-6 py-3.5 font-bold text-ink transition-colors hover:bg-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.4-.3Z"
            ></path></svg
          >
          Escríbenos por WhatsApp
        </a>
      </div>
    </div>

    <!-- Estudiante sobre los arcos -->
    <div class="relative h-[400px] sm:h-[480px] lg:col-span-5 lg:h-auto">
      <Arcs class="absolute -right-24 bottom-0 z-0 h-[118%] w-auto max-w-none sm:-right-16 lg:-right-16 lg:h-[128%]" />
      <Image
        src={student}
        alt="Estudiante sonriendo y señalando hacia el texto"
        widths={[400, 640, 830]}
        sizes="(min-width: 1024px) 34vw, 70vw"
        loading="eager"
        fetchpriority="high"
        class="student absolute bottom-0 left-1/2 z-10 h-[96%] w-auto max-w-none -translate-x-1/2 drop-shadow-[0_28px_40px_rgb(3_63_51/0.45)] lg:left-[44%]"
      />
    </div>
  </div>
</section>

<!-- Credenciales oficiales, justo debajo de la portada -->
<section class="border-b border-forest/10 bg-white px-5 md:px-10" aria-label="Respaldo oficial">
  <ul class="mx-auto grid max-w-[1320px] gap-4 py-6 sm:grid-cols-3 sm:gap-8 md:py-8">
    {
      proof.map((p) => (
        <li class="flex items-center gap-3 font-bold leading-snug text-forest-deep">
          <svg class="shrink-0" width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
            <circle cx="14" cy="14" r="14" fill="#4dd47e" />
            <path d="m8.5 14.4 3.6 3.6 7.4-7.4" stroke="#033f33" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          {p}
        </li>
      ))
    }
  </ul>
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in {
      animation: hero-rise 0.8s var(--ease-snap) both;
      animation-delay: var(--d, 0ms);
    }
    /* usa transform (no translate) porque translate ya centra la imagen */
    .student {
      animation: student-rise 1s var(--ease-snap) 0.25s both;
    }
  }
  @keyframes student-rise {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0;
      translate: 0 28px;
    }
  }
</style>
